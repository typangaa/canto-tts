{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CantoTTS",
  "version": "0.1.4",
  "identifier": "com.typangaa.cantotts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CantoTTS 廣東話語音合成",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; media-src 'self' blob: data: mediastream:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* ipc: tauri:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bin/canto-tts-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNzIxMTQ1RkIwN0M3QTcKUldTbnh3ZjdSUkZ5Y0t6N1ZSU0F6ckNIeXdVYXViUjhCWEJXZmlDenB4Z3hVeEtvRG9rOGwrd0sK",
      "endpoints": [
        "https://github.com/typangaa/canto-tts/releases/latest/download/latest.json"
      ]
    }
  }
}
